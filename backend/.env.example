# ─── Copy this file to .env and fill in your values ──────────────────────────

# OpenAI API Key (optional — chatbot works without it via local fallback)
OPENAI_API_KEY=

# OpenAI model to use (gpt-3.5-turbo or gpt-4)
OPENAI_MODEL=gpt-3.5-turbo

# HuggingFace local model (used when OpenAI key is absent or fails)
# Options: facebook/blenderbot-400M-distill | distilgpt2
LOCAL_MODEL_NAME=facebook/blenderbot-400M-distill

# Whether to eagerly load the local HuggingFace model at startup
# Set to false to save startup time (model loads on first use instead)
PRELOAD_LOCAL_MODEL=false

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./chatbot.db

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Maximum conversation turns kept in context memory per session
CONTEXT_WINDOW=10

# Minimum intent confidence score (0-1) before falling back to LLM
INTENT_CONFIDENCE_THRESHOLD=0.35
